class EnvVault < Formula
  desc "Secure environment variable vault for running commands with profiles"
  homepage "https://github.com/ildarbinanas-design/env-vault"
  version "$version"
  license "MIT"

  on_macos do
    depends_on macos: :sequoia

    on_arm do
      url "https://github.com/ildarbinanas-design/env-vault/releases/download/v$version/env-vault-darwin-arm64.tar.gz"
      sha256 "$sha256_darwin_arm64"
    end

    on_intel do
      url "https://github.com/ildarbinanas-design/env-vault/releases/download/v$version/env-vault-darwin-amd64.tar.gz"
      sha256 "$sha256_darwin_amd64"
    end
  end

  on_linux do
    on_arm do
      url "https://github.com/ildarbinanas-design/env-vault/releases/download/v$version/env-vault-linux-arm64.tar.gz"
      sha256 "$sha256_linux_arm64"
    end

    on_intel do
      url "https://github.com/ildarbinanas-design/env-vault/releases/download/v$version/env-vault-linux-amd64.tar.gz"
      sha256 "$sha256_linux_amd64"
    end
  end

  def install
    bin.install "env-vault"
    doc.install %w[README.md LICENSE THIRD_PARTY_NOTICES.md]
  end

  test do
    assert_match "v#{version}", shell_output("#{bin}/env-vault --version")
  end
end
